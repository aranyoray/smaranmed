SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=smaran
# Shared staff key. Every /api route except /api/health needs it (X-Staff-Key).
# Use a long random value; set the same one in Convex: npx convex env set STAFF_KEY ...
STAFF_KEY=
# Browser origins allowed to call the API, comma separated.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://smaran.vercel.app
# Nightly sync inside the API process, at settings.sync_schedule (clinic time).
# Turn off when a separate cron runs: python -m backend.scheduler --once
SCHEDULER_ENABLED=true
CLINIC_TIMEZONE=Asia/Kolkata
# Public Convex URL. Put the same value in the convex-url meta tag in index.html.
# Keep model keys in Convex env (npx convex env set OPENAI_API_KEY ...), not in the browser.
CONVEX_URL=
